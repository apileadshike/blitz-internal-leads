BLITZ_API_KEY=
PORT=4000
BLITZ_RPS=50
# Seconds to wait for one Blitz answer (broad searches can be slow). Default 120.
# BLITZ_TIMEOUT=120

# Supabase Postgres. Supabase dashboard → Connect → "Session pooler" connection string,
# with your database password filled in. Server-side only: never expose it to the browser.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Connections the app may open (Supabase free plan allows ~60 in total)
DB_POOL_SIZE=10

# Required on any server reachable from the internet (browser asks for it; any username)
APP_PASSWORD=

# Folder with the job files (one JSON file per pipeline)
JOBS_DIR=jobs

# Queue defaults (both can also be changed on the Jobs page)
MAX_PARALLEL_JOBS=2
DAILY_RECORD_BUDGET=20000

# Optional: Slack/Discord webhook URL for job finished / failed alerts
ALERT_WEBHOOK_URL=

# ── Where background work runs ──
#   worker  → the always-on worker process (`npm run worker`, on the VPS). Set this on Vercel.
#   trigger → Trigger.dev tasks (needs TRIGGER_SECRET_KEY)
#   empty   → the web server runs its own worker (one machine, e.g. local dev with `npm run dev`)
EXECUTION=
# Worker process only: false on all but one worker if you run several
RUN_SCHEDULER=true

# ── Queue workers ──
# Empty EXECUTION only: the web server runs a worker too. RUN_WORKER=false turns that off.
RUN_WORKER=true
# Batches one worker process handles at the same time
WORKER_SLOTS=6
# Search-paging jobs one worker process runs at the same time
SOURCE_CONCURRENCY=4

# ── Cloudflare R2 (file storage: imported lists + background exports) ──
# Preferred over Supabase Storage when set. Cloudflare dashboard → R2 → create bucket;
# R2 → Manage API tokens → "Object Read & Write" for that bucket. Server-only values.
# The bucket also needs a CORS rule so the browser can upload to it (see README).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Supabase Storage (fallback for background exports when R2 isn't set) ──
# Project Settings → API Keys → Secret keys. Server-only: never put it in NEXT_PUBLIC_ variables.
SUPABASE_SECRET_KEY=
# Optional: worked out from DATABASE_URL when empty
SUPABASE_URL=

# ── Hosting ──
# On Vercel: DATABASE_URL = Supabase *transaction pooler* (port 6543), JOB_FILES=off.
# Vercel sets VERCEL=1, which keeps each instance to 3 database connections (override with DB_POOL_SIZE).
JOB_FILES=on
